# Ignore Git metadata
.git
.github

# Ignore Bazel symlinks and metadata
bazel-*
.ijwb
.bazelignore.user
.bazel-deploy-cache/

# Ignore Go build artifacts
*.o
*.a
*.so
*.exe
*.test
*.prof
/dist/
bin/

# Ignore Node/React build files and cache
node_modules/
.next/
dist/
build/
.npm
.eslintcache
.parcel-cache
.cache/
.pnpm-debug.log*

# Ignore Python virtual environment
.venv/

# Ignore Android & Gradle build files
.gradle/
**/.gradle/
**/build/
# Ignore heavy machine learning models (Android local edge models)
third_party/gemma/

# Ignore scratch and temporary directories
scratch/
scratch
db_loader

# Ignore Terraform files (keep secrets out of builds)
*passwords_registry.csv
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.log
tf.log
