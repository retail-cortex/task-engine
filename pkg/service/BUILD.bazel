load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "service",
    srcs = [
        "admin.go",
        "automation.go",
        "rag.go",
        "scheduler.go",
        "shift.go",
        "task.go",
    ],
    importpath = "github.com/rmcguinness/gemini_task_engine/pkg/service",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/model",
        "//pkg/persistence",
        "@com_github_google_uuid//:uuid",
        "@io_gorm_gorm//:gorm",
    ],
)

go_test(
    name = "service_test",
    srcs = [
        "automation_test.go",
        "rag_test.go",
        "scheduler_test.go",
        "shift_test.go",
        "task_test.go",
    ],
    embed = [":service"],
    deps = [
        "//pkg/model",
        "//pkg/persistence",
        "@com_github_stretchr_testify//assert",
        "@io_gorm_driver_postgres//:postgres",
        "@io_gorm_gorm//:gorm",
    ],
)
