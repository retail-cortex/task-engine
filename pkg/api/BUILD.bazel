load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "api",
    srcs = [
        "admin.go",
        "chat.go",
        "mcp.go",
        "middleware.go",
        "operational.go",
        "server.go",
    ],
    importpath = "github.com/rmcguinness/gemini_task_engine/pkg/api",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/agents",
        "//pkg/model",
        "//pkg/service",
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_metoro_io_mcp_golang//:mcp-golang",
        "@com_github_metoro_io_mcp_golang//transport/http",
        "@io_gorm_gorm//:gorm",
        "@org_golang_google_api//idtoken",
    ],
)

go_test(
    name = "api_test",
    srcs = [
        "chat_test.go",
        "mcp_test.go",
        "server_test.go",
    ],
    deps = [
        ":api",
        "//pkg/agents",
        "//pkg/model",
        "//pkg/service",
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_stretchr_testify//assert",
    ],
)
