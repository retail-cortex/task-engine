load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "github.com/rmcguinness/gemini_task_engine/cmd/server",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/api",
        "//pkg/persistence",
        "//pkg/service",
        "//pkg/telemetry",
        "@modenv//pkg/modenv",
    ],
)

go_binary(
    name = "server",
    data = [
        "//:.env.dev.toml",
        "//:.env.local.toml",
        "//:.env.toml",
    ],
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "dev",
    srcs = ["run_server.sh"],
    data = [
        "main.go",
        ":server",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)
