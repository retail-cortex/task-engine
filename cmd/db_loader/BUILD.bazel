load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "db_loader_lib",
    srcs = ["main.go"],
    importpath = "github.com/rmcguinness/gemini_task_engine/cmd/db_loader",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/agents",
        "//pkg/model",
        "//pkg/persistence",
        "@io_gorm_gorm//:gorm",
        "@modenv//pkg/modenv",
    ],
)

go_binary(
    name = "db_loader",
    data = [
        "//:.env.local.toml",
        "//:.env.toml",
    ],
    embed = [":db_loader_lib"],
    visibility = ["//visibility:public"],
)
